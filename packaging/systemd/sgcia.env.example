# Copy to /etc/sgcia/sgcia.env, fill in real values, and
# `chmod 600 /etc/sgcia/sgcia.env` -- referenced from config.yaml as
# ${VAR_NAME} (e.g. token: ${S1_HEC_TOKEN}), substituted at load time.
# Only include the variables your config.yaml actually references.

S1_HEC_TOKEN=replace-with-real-token
SPLUNK_HEC_TOKEN=replace-with-real-token
